# ── Server ──────────────────────────────────────────────
PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────
# Local docker:   docker compose up -d
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5432/nimbus?schema=public

# ── Clerk (same instance as the website) ────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Svix signing secret for Clerk webhooks (Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# ── Razorpay ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Dashboard → Settings → Webhooks → secret you choose
RAZORPAY_WEBHOOK_SECRET=...

# ── KubeVirt cluster (kubevirt.playnimbuz.com) ──────────
# Leave K8S_API_URL empty to run sessions without real VMs (dev).
K8S_API_URL=https://<kube-apiserver>:6443
K8S_TOKEN=            # from deploy/k8s/00-namespace-rbac.yaml
K8S_CA_B64=           # base64 cluster CA (ca.crt from the same secret)
K8S_INSECURE_SKIP_TLS=false
K8S_NAMESPACE=gaming
# adopt (default): use your existing VMs (NVMesh disks, games installed) — label them via POST /v1/infra/pool/adopt
# clone: also auto-create VMs whose NVMesh boot disk is cloned from SOURCE_DISK_PVC, up to VM_POOL
VM_CREATE_MODE=adopt
K8S_STORAGE_CLASS=nvmesh-raid10
# Golden image (NVMesh PVC: Windows + drivers + launchers + agent + games) — set once it's built.
GOLDEN_IMAGE_PVC=
# …or clone an existing VM's NVMesh disk instead
SOURCE_DISK_PVC=
BOOT_DISK_SIZE=500Gi
# NVMesh game library (live: gaming/np-game-library, 7451Gi Block RWO on nvmesh-golden-retain, serial NIMBUSGAME)
# RWO → can't be shared directly: clone = per-VM NVMesh copy · shared = an RWX copy attached read-only · none
GAME_LIBRARY_MODE=clone
GAME_LIBRARY_PVC=np-game-library
GAME_LIBRARY_NAMESPACE=gaming
GAME_LIBRARY_STORAGE_CLASS=nvmesh-golden-retain
GAME_LIBRARY_SIZE=7451Gi
GAME_LIBRARY_SERIAL=NIMBUSGAME
# Never lease/stop these (the build VM owns the RWO library)
POOL_PROTECTED_VMS=golden-windows-build
# Optional node pinning for cloned VMs, e.g. {"nimbus.io/region":"{region}"}
VM_NODE_SELECTOR=
# Target pool size per region/tier (clone mode only)
VM_POOL={"mumbai":{"basic":4,"pro":2,"premium":1,"ultimate":1}}

# ── Streaming agent on the VM ───────────────────────────
# Shared with the agent so it can verify tokens offline
STREAM_TOKEN_SECRET=change-me-to-32+-random-bytes
# {ip} {vm} {region} — direct to VM, or through a gateway like wss://stream.playnimbuz.com/{vm}
STREAM_URL_TEMPLATE=wss://{ip}:8443/stream

# ── Game data ───────────────────────────────────────────
RAWG_API_KEY=...
KINGUIN_API_KEY=
