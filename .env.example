# ── Server ──────────────────────────────────────────────
PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────
# Local docker:   docker compose up -d
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5432/nimbus?schema=public

# ── Clerk (same instance as the website) ────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Svix signing secret for Clerk webhooks (Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# ── Razorpay ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Dashboard → Settings → Webhooks → secret you choose
RAZORPAY_WEBHOOK_SECRET=...

# ── Game data ───────────────────────────────────────────
RAWG_API_KEY=...
KINGUIN_API_KEY=
